{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xevansmithx-del/phytobench/schema/source_registry.schema.json",
  "title": "PhytoBench source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "phytobench-source-registry-v1"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "uri": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "canonical_url",
        "publisher",
        "publication_date",
        "accessed_at",
        "roles",
        "parent_source_ids",
        "first_public_at",
        "contains_truth_labels",
        "used_for_training",
        "content_sha256",
        "metadata_sha256",
        "lineage_root_digest",
        "license"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "canonical_url": {"$ref": "#/$defs/uri"},
        "archived_url": {
          "oneOf": [
            {"const": ""},
            {"$ref": "#/$defs/uri"}
          ]
        },
        "publisher": {"type": "string", "minLength": 1, "maxLength": 200},
        "publication_date": {"$ref": "#/$defs/date"},
        "accessed_at": {"$ref": "#/$defs/date"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TRUTH_AUTHORITY",
              "PRETRUTH_EVIDENCE",
              "NULL_AUTHORITY",
              "SPLIT_AUTHORITY",
              "LICENSE_AUTHORITY"
            ]
          }
        },
        "parent_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 128}
        },
        "first_public_at": {"$ref": "#/$defs/date"},
        "contains_truth_labels": {"enum": ["YES", "NO", "UNKNOWN"]},
        "used_for_training": {"enum": ["YES", "NO", "UNKNOWN"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "lineage_root_digest": {"$ref": "#/$defs/sha256"},
        "retrieval_method": {"type": "string", "minLength": 1, "maxLength": 200},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "authorization_scope",
            "license_id",
            "license_url",
            "evidence_sha256",
            "reviewer_id",
            "review_receipt_sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "VERIFIED_OPEN",
                "VERIFIED_PERMISSION",
                "METADATA_CITATION_ONLY",
                "RESTRICTED",
                "UNKNOWN"
              ]
            },
            "authorization_scope": {
              "enum": [
                "PUBLIC_FULL",
                "PUBLIC_METADATA",
                "LOCAL_ANALYSIS_ONLY",
                "NONE"
              ]
            },
            "license_id": {"type": "string", "minLength": 1, "maxLength": 100},
            "license_url": {"$ref": "#/$defs/uri"},
            "evidence_sha256": {"$ref": "#/$defs/sha256"},
            "reviewer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
            "review_receipt_sha256": {"$ref": "#/$defs/sha256"},
            "authorization_receipt_sha256": {
              "oneOf": [
                {"const": ""},
                {"$ref": "#/$defs/sha256"}
              ]
            }
          }
        }
      }
    }
  }
}
